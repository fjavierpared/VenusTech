---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import VpnNav from '../../../../components/admin/VpnNav.astro';
import VpnCredenciales from '../../../../components/admin/VpnCredenciales.astro';
import Icon from '../../../../components/Icon.astro';
import {
  cliente, dispositivos, ESTADOS, estadoDe, fechaCorta, enlaceWa, fijarAcceso,
  editarCliente, suspender, restablecerClave, borrarDispositivo, borrarCliente, sincronizar,
  mensajeClaveNueva, cambiarAccesoVps, esIpVps, ipsVpsLibres, VPS_RANGO_TEXTO,
} from '../../../../lib/vpn';

export const prerender = false;

const id = Number(Astro.params.id);
if (!cliente(id)) return Astro.redirect('/admin/vpn/clientes');

const campo = 'mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-navy-700';
let error = '';
let aviso = '';
let claveNueva: string | null = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const g = (k: string) => String(f.get(k) ?? '');
  try {
    switch (g('accion')) {
      case 'acceso_siempre':
        await fijarAcceso(id, null);
        aviso = 'Listo: su acceso ya no vence.';
        break;
      case 'acceso_dias':
        await fijarAcceso(id, Number(g('dias')));
        aviso = `Listo: su acceso vence el ${fechaCorta(cliente(id)!.vence_en)}.`;
        break;
      case 'editar':
        editarCliente(id, { nombre: g('nombre'), correo: g('correo'), whatsapp: g('whatsapp'), notas: g('notas'), maxDispositivos: Number(g('dispositivos')) });
        aviso = 'Datos guardados.';
        break;
      case 'clave':
        claveNueva = restablecerClave(id);
        break;
      case 'clave_propia':
        claveNueva = restablecerClave(id, g('clave'));
        break;
      case 'suspender':
        await suspender(id, true);
        aviso = 'Usuario suspendido: su VPN se desconectó.';
        break;
      case 'reactivar':
        await suspender(id, false);
        aviso = 'Usuario reactivado.';
        break;
      case 'borrar_disp':
        await borrarDispositivo(Number(g('disp')));
        aviso = 'Dispositivo liberado: puede entrar desde otro teléfono.';
        break;
      case 'vps_on':
        await cambiarAccesoVps(id, true);
        aviso = 'Acceso a todo el VPS activado. Sus dispositivos lo tendrán en cuanto la app se actualice (al abrirla).';
        break;
      case 'vps_off':
        await cambiarAccesoVps(id, false);
        aviso = 'Acceso al VPS quitado. Sus dispositivos lo pierden en cuanto la app se actualice.';
        break;
      case 'sincronizar':
        await sincronizar(id);
        aviso = 'Estado aplicado de nuevo en el servidor VPN.';
        break;
      case 'borrar':
        await borrarCliente(id);
        return Astro.redirect('/admin/vpn/clientes');
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const c = cliente(id)!;
const estado = estadoDe(c);
const disp = dispositivos(id);
const libresVps = await ipsVpsLibres();
const fechaHora = (ts: number | null) =>
  ts ? new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium', timeStyle: 'short' }).format(ts) : 'Nunca';
---

<AdminLayout titulo={c.nombre}>
  <VpnNav />

  {error && <p class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  {aviso && <p class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900">{aviso}</p>}
  {
    claveNueva && (
      <VpnCredenciales
        titulo="Contraseña nueva (la anterior ya no sirve)"
        correo={c.correo}
        clave={claveNueva}
        wa={enlaceWa(c.whatsapp, mensajeClaveNueva(c, claveNueva))}
        mensaje={mensajeClaveNueva(c, claveNueva)}
      />
    )
  }

  <!-- Cabecera del cliente -->
  <section class="rounded-2xl border border-slate-200 bg-white p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', ESTADOS[estado].clase]}>{ESTADOS[estado].texto}</span>
          <span class="text-sm text-gris">Usuario desde {fechaCorta(c.creado_en)}</span>
        </div>
        <p class="mt-2 text-sm break-all text-gris">{c.correo}{c.whatsapp && <> · {c.whatsapp}</>}</p>
        {c.notas && <p class="mt-2 text-sm whitespace-pre-line text-tinta">{c.notas}</p>}
      </div>
      <div class="text-right">
        <p class="text-sm text-gris">Acceso</p>
        <p class="font-display text-2xl font-bold text-navy-900">{c.vence_en ? `Hasta ${fechaCorta(c.vence_en)}` : 'Sin vencimiento'}</p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
      <form method="post">
        <button name="accion" value="clave" class="rounded-full border border-slate-300 px-3 py-1.5 text-sm" onclick="return confirm('¿Generar una contraseña nueva? La actual dejará de servir y se cerrará su sesión en la app.')">
          Generar contraseña nueva
        </button>
      </form>
      <form method="post" class="flex flex-wrap items-center gap-2" autocomplete="off">
        <input id="clave-propia" name="clave" type="text" required minlength="8" maxlength="72" placeholder="Contraseña propia (mín. 8)" aria-label="Contraseña propia" spellcheck="false" autocomplete="new-password" class="w-52 rounded-full border border-slate-300 px-3 py-1.5 text-sm" />
        <button name="accion" value="clave_propia" class="rounded-full border border-slate-300 px-3 py-1.5 text-sm" onclick="return confirm('¿Poner esta contraseña? La actual dejará de servir y se cerrará su sesión en la app.')">
          Poner esta contraseña
        </button>
      </form>
      <form method="post">
        {
          c.suspendido ? (
            <button name="accion" value="reactivar" class="rounded-full border border-emerald-300 px-3 py-1.5 text-sm text-emerald-800">Reactivar</button>
          ) : (
            <button name="accion" value="suspender" class="rounded-full border border-amber-300 px-3 py-1.5 text-sm text-amber-800" onclick="return confirm('¿Suspender? Su VPN se desconecta hasta que lo reactives.')">
              Suspender
            </button>
          )
        }
      </form>
    </div>
  </section>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <!-- Duración del acceso -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-navy-900">Duración del acceso</h2>
      <p class="text-sm text-gris">
        Ahora: <strong class="text-navy-900">{c.vence_en ? `vence el ${fechaCorta(c.vence_en)}` : 'sin vencimiento'}</strong>.
        Para cortarle el acceso de inmediato usa "Suspender".
      </p>
      <div class="mt-4 grid gap-3">
        <form method="post">
          <button name="accion" value="acceso_siempre" disabled={c.vence_en === null} class="rounded-full border border-slate-300 px-4 py-2 text-sm disabled:opacity-50">
            Dejar sin vencimiento
          </button>
        </form>
        <form method="post" class="flex flex-wrap items-center gap-2 text-sm">
          <span>Que venza en</span>
          <input id="acc-dias" name="dias" type="number" min="1" max="3650" value="30" required aria-label="Días" class="w-20 rounded-lg border border-slate-300 px-2 py-1.5" />
          <span>días desde hoy</span>
          <button name="accion" value="acceso_dias" class="rounded-full bg-navy-900 px-4 py-2 font-semibold text-white">Aplicar</button>
        </form>
      </div>
    </section>

    <!-- Dispositivos -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-navy-900">Dispositivos ({disp.length} de {c.max_dispositivos})</h2>
      <p class="text-sm text-gris">Se agregan solos cuando entra a la app desde un teléfono o PC nuevo.</p>
      <form method="post" class:list={['mt-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border p-3 text-sm', c.acceso_vps ? 'border-amber-300 bg-amber-50' : 'border-slate-200 bg-slate-50']}>
        <span class="min-w-0">
          <span class="block font-semibold text-navy-900">Acceso a todo el VPS: {c.acceso_vps ? 'Sí' : 'No'}</span>
          <span class="block text-xs text-gris">
            IPs del grupo {VPS_RANGO_TEXTO}{libresVps !== null && <> · quedan {libresVps} libres</>}
          </span>
        </span>
        {
          c.acceso_vps ? (
            <button name="accion" value="vps_off" class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-semibold">Quitar acceso</button>
          ) : (
            <button name="accion" value="vps_on" class="rounded-full bg-amber-600 px-3 py-1.5 text-xs font-semibold text-white" onclick="return confirm('¿Dar acceso a TODO el VPS (SSH, paneles, redes internas) a los dispositivos de este usuario? Solo para personal de confianza.')">
              Dar acceso
            </button>
          )
        }
      </form>
      {
        disp.length === 0 ? (
          <p class="mt-4 rounded-xl bg-slate-50 p-5 text-center text-sm text-gris">Aún no ha entrado a la app desde ningún dispositivo.</p>
        ) : (
          <ul class="mt-4 divide-y divide-slate-100">
            {disp.map((d) => (
              <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
                <span class="min-w-0">
                  <span class="block truncate font-medium text-navy-900">{d.nombre}</span>
                  <span class="block text-xs text-gris">
                    IP <span class="font-mono">{d.ip ?? '—'}</span>
                    {esIpVps(d.ip) && <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 font-semibold text-amber-800">Acceso al VPS</span>}
                    · desde {fechaCorta(d.creado_en)} · último uso {fechaHora(d.ultimo_acceso)}
                  </span>
                </span>
                <form method="post">
                  <input type="hidden" name="disp" value={d.id} />
                  <button name="accion" value="borrar_disp" class="rounded-full border border-red-200 px-3 py-1 text-xs text-red-700" onclick="return confirm('¿Liberar este dispositivo? Se desconecta y podrá entrar desde otro.')">
                    Liberar
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <!-- Editar datos -->
  <details class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
    <summary class="cursor-pointer font-semibold text-navy-900">Editar datos del usuario</summary>
    <form method="post" class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-medium text-navy-900">Nombre<input id="e-nombre" name="nombre" value={c.nombre} required class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">Correo (usuario)<input id="e-correo" name="correo" type="email" value={c.correo} required class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">WhatsApp<input id="e-wa" name="whatsapp" value={c.whatsapp ?? ''} class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">Dispositivos permitidos<input id="e-disp" name="dispositivos" type="number" min="1" max="10" value={c.max_dispositivos} class={campo} /></label>
      <label class="text-sm font-medium text-navy-900 sm:col-span-2">Notas<textarea id="e-notas" name="notas" rows="2" class={campo}>{c.notas ?? ''}</textarea></label>
      <div class="flex flex-wrap items-center justify-between gap-3 sm:col-span-2">
        <button name="accion" value="editar" class="rounded-full bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white">Guardar</button>
        <span class="flex gap-2">
          <button name="accion" value="sincronizar" formnovalidate class="rounded-full border border-slate-300 px-3 py-1.5 text-xs">Reaplicar en servidor</button>
          <button name="accion" value="borrar" formnovalidate class="rounded-full border border-red-200 px-3 py-1.5 text-xs text-red-700" onclick="return confirm('¿Borrar este usuario y sus dispositivos? No se puede deshacer.')">
            Borrar usuario
          </button>
        </span>
      </div>
    </form>
  </details>
</AdminLayout>
