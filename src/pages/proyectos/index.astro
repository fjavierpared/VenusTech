---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaFinal from '../../components/CtaFinal.astro';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.orden - b.data.orden);
const migas = [{ name: 'Proyectos', path: '/proyectos' }];
---

<BaseLayout
  title="Proyectos y casos de éxito"
  description="Proyectos de VenusTech: sistemas web a medida, ERP para pymes y soluciones de infraestructura desarrolladas en Venezuela."
  breadcrumbs={migas}
>
  <PageHero
    banda="Proyectos"
    titulo="Sistemas reales que resuelven problemas reales"
    texto="Cada proyecto empieza con un problema concreto. Aquí te cuento cuál era, cómo lo resolví y qué se logró."
    migas={migas}
  />

  <section class="bg-white py-20">
    <div class="container-vt grid gap-6 lg:grid-cols-2">
      {
        proyectos.map((p) => (
          <article class="reveal group relative flex flex-col rounded-[2rem] border border-navy-700/10 bg-white p-7 shadow-sm transition hover:shadow-lg sm:p-9">
            <p class="text-sm font-semibold tracking-wide text-naranja uppercase">{p.data.categoria}</p>
            <h2 class="mt-2 text-2xl font-bold text-navy-900">
              <a href={`/proyectos/${p.id}`} class="after:absolute after:inset-0 group-hover:text-navy-700">
                {p.data.titulo}
              </a>
            </h2>
            <p class="mt-1 text-sm text-gris">{p.data.cliente}</p>
            <p class="mt-4 flex-1 leading-relaxed text-gris">{p.data.resumen}</p>
            {p.data.metricas.length > 0 && (
              <dl class="mt-6 grid grid-cols-2 gap-3">
                {p.data.metricas.slice(0, 4).map((m) => (
                  <div class="rounded-2xl bg-crema/70 px-4 py-3">
                    <dt class="sr-only">{m.etiqueta}</dt>
                    <dd class="font-display text-2xl font-bold text-navy-900">{m.valor}</dd>
                    <dd class="text-xs text-gris">{m.etiqueta}</dd>
                  </div>
                ))}
              </dl>
            )}
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-navy-700 group-hover:text-naranja">
              Ver caso completo <Icon name="arrow-right" size={18} />
            </span>
          </article>
        ))
      }
    </div>
  </section>

  <CtaFinal titulo="¿Tu negocio necesita un sistema así?" texto="Cuéntame cómo trabajas hoy y te propongo cómo automatizarlo." />
</BaseLayout>
