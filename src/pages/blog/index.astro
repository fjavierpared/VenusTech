---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { fechaLarga, minutosLectura, publicadas } from '../../lib/publicaciones';
import { SITE } from '../../data/site';

// Se genera en el servidor para mostrar al instante lo que publiques desde el panel
export const prerender = false;

const posts = publicadas();
const [principal, ...resto] = posts;
const secundarias = resto.slice(0, 2);
const archivo = resto.slice(2);
const migas = [{ name: 'Blog', path: '/blog' }];
Astro.response.headers.set('Cache-Control', 'public, max-age=60');

const iso = (ts: number) => new Date(ts).toISOString();

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Blog de VenusTech',
  url: new URL('/blog', SITE.url).href,
  publisher: { '@id': `${SITE.url}/#negocio` },
  blogPost: posts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.titulo,
    url: new URL(`/blog/${p.slug}`, SITE.url).href,
    datePublished: iso(p.publicado_en!),
  })),
};
---

<BaseLayout
  title={`Blog: trabajos, consejos y tecnología en ${SITE.city}`}
  description="Trabajos recientes, consejos de tecnología y novedades de VenusTech: páginas web, soporte técnico, servidores y cámaras de seguridad en Mérida."
  breadcrumbs={migas}
  schema={[blog]}
>
  <!-- Cabecera tipo revista -->
  <header class="border-b-4 border-navy-900 bg-crema/60">
    <div class="container-vt pt-10 pb-6 sm:pt-14">
      <nav aria-label="Ruta de navegación" class="text-sm text-gris">
        <a href="/" class="hover:text-navy-700">Inicio</a> <span aria-hidden="true" class="mx-1.5">/</span>
        <span aria-current="page" class="text-tinta">Blog</span>
      </nav>
      <div class="mt-6 flex flex-col gap-4 border-b border-navy-900/15 pb-6 sm:flex-row sm:items-end sm:justify-between">
        <h1 class="font-display text-5xl leading-none font-extrabold tracking-tight text-navy-900 sm:text-7xl">
          Revista <span class="text-naranja">VenusTech</span>
        </h1>
        <p class="max-w-sm font-serif text-lg leading-snug text-gris italic sm:text-right">
          Trabajos, consejos y novedades de tecnología, explicados en claro.
        </p>
      </div>
      <p class="mt-3 flex flex-wrap justify-between gap-2 font-display text-xs font-semibold tracking-[0.2em] text-navy-700 uppercase">
        <span>Web · Soporte TI · Servidores · Videovigilancia</span>
        <span>{SITE.city}, {SITE.country}</span>
      </p>
    </div>
  </header>

  <section class="bg-white py-12 sm:py-16">
    <div class="container-vt">
      {
        !principal ? (
          <p class="py-10 text-center font-serif text-xl text-gris italic">
            Muy pronto publicaré aquí los primeros trabajos y consejos.
          </p>
        ) : (
          <>
            {/* Portada: nota principal + dos secundarias */}
            <div class="grid gap-10 lg:grid-cols-[1.7fr_1fr] lg:gap-12">
              <article class="group relative">
                <div class="aspect-[16/10] overflow-hidden rounded-xl bg-navy-900">
                  {principal.portada ? (
                    <img
                      src={principal.portada}
                      alt=""
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <div class="flex h-full items-center justify-center text-ambar">
                      <Icon name="file-text" size={56} />
                    </div>
                  )}
                </div>
                <p class="mt-6 font-display text-xs font-bold tracking-[0.2em] text-naranja-600 uppercase">
                  Lo más reciente
                </p>
                <h2 class="mt-2 font-display text-3xl leading-tight font-extrabold text-navy-900 sm:text-[2.6rem]">
                  <a href={`/blog/${principal.slug}`} class="after:absolute after:inset-0 group-hover:text-navy-700">
                    {principal.titulo}
                  </a>
                </h2>
                {principal.resumen && (
                  <p class="mt-4 font-serif text-xl leading-relaxed text-gris">{principal.resumen}</p>
                )}
                <p class="mt-4 text-sm text-gris">
                  Por {SITE.owner} · <time datetime={iso(principal.publicado_en!)}>{fechaLarga(principal.publicado_en!)}</time>{' '}
                  · {minutosLectura(principal.contenido)} min de lectura
                </p>
              </article>

              {secundarias.length > 0 && (
                <div class="flex flex-col divide-y divide-navy-900/10 lg:border-l lg:border-navy-900/10 lg:pl-12">
                  {secundarias.map((p) => (
                    <article class="group relative py-6 first:pt-0 last:pb-0">
                      {p.portada && (
                        <div class="mb-4 aspect-video overflow-hidden rounded-lg bg-navy-900">
                          <img src={p.portada} alt="" loading="lazy" class="h-full w-full object-cover" />
                        </div>
                      )}
                      <time class="font-display text-xs font-bold tracking-[0.18em] text-naranja-600 uppercase" datetime={iso(p.publicado_en!)}>
                        {fechaLarga(p.publicado_en!)}
                      </time>
                      <h3 class="mt-1 font-display text-xl leading-snug font-bold text-navy-900">
                        <a href={`/blog/${p.slug}`} class="after:absolute after:inset-0 group-hover:text-navy-700">
                          {p.titulo}
                        </a>
                      </h3>
                      {p.resumen && <p class="mt-2 line-clamp-3 font-serif text-lg leading-snug text-gris">{p.resumen}</p>}
                    </article>
                  ))}
                </div>
              )}
            </div>

            {/* Resto de las notas */}
            {archivo.length > 0 && (
              <div class="mt-16 border-t-4 border-navy-900 pt-6">
                <h2 class="font-display text-sm font-bold tracking-[0.25em] text-navy-900 uppercase">Más publicaciones</h2>
                <div class="mt-8 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
                  {archivo.map((p) => (
                    <article class="group relative">
                      <div class="aspect-[3/2] overflow-hidden rounded-lg bg-navy-900">
                        {p.portada ? (
                          <img src={p.portada} alt="" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
                        ) : (
                          <div class="flex h-full items-center justify-center text-ambar">
                            <Icon name="file-text" size={36} />
                          </div>
                        )}
                      </div>
                      <time class="mt-4 block font-display text-xs font-bold tracking-[0.18em] text-naranja-600 uppercase" datetime={iso(p.publicado_en!)}>
                        {fechaLarga(p.publicado_en!)}
                      </time>
                      <h3 class="mt-1 font-display text-xl leading-snug font-bold text-navy-900">
                        <a href={`/blog/${p.slug}`} class="after:absolute after:inset-0 group-hover:text-navy-700">
                          {p.titulo}
                        </a>
                      </h3>
                      {p.resumen && <p class="mt-2 line-clamp-3 font-serif text-lg leading-snug text-gris">{p.resumen}</p>}
                      <p class="mt-2 text-sm text-gris">{minutosLectura(p.contenido)} min de lectura</p>
                    </article>
                  ))}
                </div>
              </div>
            )}
          </>
        )
      }
    </div>
  </section>

  <CtaFinal />
</BaseLayout>
