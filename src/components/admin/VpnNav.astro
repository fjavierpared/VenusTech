---
// Submenú del CRM VPN
const path = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { href: '/admin/vpn', label: 'Resumen' },
  { href: '/admin/vpn/clientes', label: 'Clientes' },
  { href: '/admin/vpn/pagos', label: 'Pagos' },
  { href: '/admin/vpn/planes', label: 'Planes y precios' },
];
const activo = (href: string) =>
  href === '/admin/vpn' ? path === '/admin/vpn' : path === href || (path.startsWith(href) && !path.endsWith('/nuevo'));
---

<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <nav class="flex gap-1 overflow-x-auto rounded-full border border-slate-300 bg-white p-0.5 text-sm" aria-label="CRM VPN">
    {
      tabs.map((t) => (
        <a
          href={t.href}
          aria-current={activo(t.href) ? 'page' : undefined}
          class:list={['shrink-0 rounded-full px-3.5 py-1.5', activo(t.href) ? 'bg-navy-900 text-white' : 'text-gris hover:text-navy-900']}
        >
          {t.label}
        </a>
      ))
    }
  </nav>
  <a href="/admin/vpn/clientes/nuevo" class="inline-flex items-center gap-1.5 rounded-full bg-naranja px-4 py-2 text-sm font-semibold text-white hover:bg-naranja-600">
    + Nuevo cliente
  </a>
</div>
