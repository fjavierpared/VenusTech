---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { todas } from '../../../lib/publicaciones';

export const prerender = false;

const lista = todas();
const fecha = (ts: number) => new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium' }).format(ts);
---

<AdminLayout titulo="Publicaciones">
  <a slot="acciones" href="/admin/publicaciones/nueva" class="btn-primary px-4 py-2 text-sm">+ Nueva publicación</a>

  {
    lista.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
        <Icon name="file-text" size={32} class="mx-auto text-slate-400" />
        <p class="mt-3 text-gris">Aún no hay publicaciones. Escribe la primera: un trabajo reciente, un consejo o una novedad.</p>
        <a href="/admin/publicaciones/nueva" class="btn-primary mt-5">Crear publicación</a>
      </div>
    ) : (
      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-gris">
            <tr>
              <th class="px-5 py-3 font-medium">Título</th>
              <th class="hidden px-5 py-3 font-medium sm:table-cell">Estado</th>
              <th class="hidden px-5 py-3 font-medium md:table-cell">Actualizada</th>
              <th class="px-5 py-3" />
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {lista.map((p) => (
              <tr>
                <td class="px-5 py-3">
                  <a href={`/admin/publicaciones/${p.id}`} class="font-semibold text-navy-900 hover:text-naranja">
                    {p.titulo}
                  </a>
                  <p class="text-xs text-gris">/blog/{p.slug}</p>
                </td>
                <td class="hidden px-5 py-3 sm:table-cell">
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-1 text-xs font-semibold',
                      p.estado === 'publicado' ? 'bg-acento/15 text-[#04706c]' : 'bg-slate-100 text-gris',
                    ]}
                  >
                    {p.estado === 'publicado' ? 'Publicada' : 'Borrador'}
                  </span>
                </td>
                <td class="hidden px-5 py-3 text-gris md:table-cell">{fecha(p.actualizado_en)}</td>
                <td class="px-5 py-3 text-right whitespace-nowrap">
                  {p.estado === 'publicado' && (
                    <a href={`/blog/${p.slug}`} target="_blank" class="mr-3 text-navy-700 hover:text-naranja">
                      Ver
                    </a>
                  )}
                  <a href={`/admin/publicaciones/${p.id}`} class="text-navy-700 hover:text-naranja">
                    Editar
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
