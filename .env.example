# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a git.

# ── Dirección pública de la web ───────────────────────────────
# Con dominio: https://tudominio.com · Sin dominio aún: https://IP-CON-GUIONES.sslip.io
SITE_URL=https://venustech.com.ve

# ── Usuario del VPS dueño de la carpeta data/ (resultado de `id -u` y `id -g`) ──
PUID=1000
PGID=1000

# ── Correo (Gmail) ─────────────────────────────────────────────
# Para avisos de mensajes nuevos y recuperación de contraseña.
# SMTP_PASS NO es tu contraseña de Gmail: es una "contraseña de aplicación" de 16 letras
# (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).
# La clave se guarda CIFRADA con:  npm run secreto:guardar -- SMTP_PASS
# (crea SMTP_PASS_ENC aquí; la llave para descifrarla queda en ~/.config/venustech/clave)
SMTP_USER=venustech47@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Correo que recibe los avisos y los enlaces de recuperación (por defecto, el de la web)
# ADMIN_EMAIL=venustech47@gmail.com

# ── Opcionales ────────────────────────────────────────────────
# DATA_DIR=./data
# VT_KEY_FILE=/ruta/a/la/llave   (por defecto ~/.config/venustech/clave)
