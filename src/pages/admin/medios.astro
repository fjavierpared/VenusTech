---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { actualizarAlt, eliminarMedio, guardarArchivo, listar, tamanoLegible, urlMedio } from '../../lib/medios';

export const prerender = false;

let errores: string[] = [];
let subidos = 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion'));
  if (accion === 'subir') {
    const alt = String(form.get('alt') ?? '').trim();
    for (const f of form.getAll('archivos')) {
      if (!(f instanceof File) || f.size === 0) continue;
      const r = await guardarArchivo(f, alt);
      if (r.ok) subidos++;
      else errores.push(r.error);
    }
    if (!errores.length) return Astro.redirect(`/admin/medios?subidos=${subidos}`);
  } else if (accion === 'eliminar') {
    await eliminarMedio(Number(form.get('id')));
    return Astro.redirect('/admin/medios');
  } else if (accion === 'alt') {
    actualizarAlt(Number(form.get('id')), String(form.get('alt') ?? ''));
    return Astro.redirect('/admin/medios');
  }
}

const ok = Number(Astro.url.searchParams.get('subidos')) || subidos;
const medios = listar();
---

<AdminLayout titulo="Imágenes y videos">
  <form method="post" enctype="multipart/form-data" class="rounded-2xl border border-slate-200 bg-white p-5" id="form-subir">
    <input type="hidden" name="accion" value="subir" />
    <label
      for="archivos"
      id="zona"
      class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-300 px-4 py-10 text-center transition hover:border-naranja"
    >
      <Icon name="layers" size={32} class="text-naranja" />
      <span class="mt-3 font-semibold text-navy-900">Arrastra aquí tus imágenes o videos, o haz clic para elegirlos</span>
      <span class="mt-1 text-sm text-gris">
        Imágenes JPG, PNG, WebP o GIF hasta 15 MB: se optimizan solas a WebP. Videos MP4 o WebM hasta 200 MB.
      </span>
      <span id="seleccion" class="mt-3 text-sm font-medium text-navy-700"></span>
    </label>
    <input id="archivos" name="archivos" type="file" multiple accept="image/*,video/mp4,video/webm" class="sr-only" required />
    <div class="mt-4 flex flex-col gap-3 sm:flex-row">
      <input
        name="alt"
        placeholder="Descripción (texto alternativo para Google y accesibilidad)"
        class="flex-1 rounded-xl border border-slate-300 px-4 py-2.5 text-sm outline-none focus:border-navy-700"
      />
      <button class="btn-primary py-2.5" id="btn-subir">Subir archivos</button>
    </div>
    <p class="mt-3 text-xs text-gris">Para videos largos conviene subirlos a YouTube e insertarlos en la publicación: cargan más rápido y no consumen tu servidor.</p>
  </form>

  {ok > 0 && <p class="mt-4 rounded-xl bg-acento/10 p-3 text-sm font-medium text-navy-900">{ok} archivo(s) subido(s) correctamente.</p>}
  {errores.length > 0 && (
    <ul class="mt-4 space-y-1 rounded-xl bg-red-50 p-3 text-sm text-red-700" role="alert">
      {errores.map((e) => <li>{e}</li>)}
    </ul>
  )}

  {
    medios.length === 0 ? (
      <p class="mt-8 text-center text-gris">Todavía no has subido archivos.</p>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {medios.map((m) => (
          <li class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
            <div class="aspect-video bg-slate-100">
              {m.tipo === 'imagen' ? (
                <img src={urlMedio(m.archivo)} alt={m.alt} loading="lazy" class="h-full w-full object-cover" />
              ) : (
                <video src={urlMedio(m.archivo)} preload="metadata" controls class="h-full w-full bg-black object-contain" />
              )}
            </div>
            <div class="space-y-3 p-4">
              <p class="truncate text-sm font-medium text-navy-900" title={m.nombre_original}>{m.nombre_original}</p>
              <p class="text-xs text-gris">
                {m.tipo === 'imagen' ? `Imagen ${m.ancho}×${m.alto}` : 'Video'} · {tamanoLegible(m.bytes)}
              </p>
              <form method="post" class="flex gap-2">
                <input type="hidden" name="accion" value="alt" />
                <input type="hidden" name="id" value={m.id} />
                <input name="alt" value={m.alt} placeholder="Descripción" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-2.5 py-1.5 text-xs" />
                <button class="rounded-lg border border-slate-300 px-2.5 text-xs">Guardar</button>
              </form>
              <div class="flex gap-2">
                <button
                  type="button"
                  class="vt-copiar flex-1 rounded-lg bg-navy-900 px-3 py-1.5 text-xs font-semibold text-white"
                  data-url={urlMedio(m.archivo)}
                >
                  Copiar enlace
                </button>
                <form method="post">
                  <input type="hidden" name="accion" value="eliminar" />
                  <input type="hidden" name="id" value={m.id} />
                  <button
                    class="rounded-lg border border-red-200 px-3 py-1.5 text-xs text-red-700"
                    onclick="return confirm('¿Eliminar este archivo? Si está en una publicación, dejará de verse.')"
                  >
                    Eliminar
                  </button>
                </form>
              </div>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</AdminLayout>

<script>
  const input = document.getElementById('archivos') as HTMLInputElement;
  const zona = document.getElementById('zona')!;
  const seleccion = document.getElementById('seleccion')!;
  const mostrar = () => {
    const n = input.files?.length ?? 0;
    seleccion.textContent = n ? `${n} archivo(s) seleccionado(s)` : '';
  };
  input.addEventListener('change', mostrar);
  ['dragenter', 'dragover'].forEach((ev) =>
    zona.addEventListener(ev, (e) => {
      e.preventDefault();
      zona.classList.add('border-naranja', 'bg-crema/50');
    }),
  );
  ['dragleave', 'drop'].forEach((ev) => zona.addEventListener(ev, () => zona.classList.remove('border-naranja', 'bg-crema/50')));
  zona.addEventListener('drop', (e) => {
    e.preventDefault();
    if (e.dataTransfer?.files.length) {
      input.files = e.dataTransfer.files;
      mostrar();
    }
  });
  document.getElementById('form-subir')?.addEventListener('submit', () => {
    const b = document.getElementById('btn-subir') as HTMLButtonElement;
    b.disabled = true;
    b.textContent = 'Subiendo…';
  });
  document.querySelectorAll<HTMLButtonElement>('.vt-copiar').forEach((b) =>
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(location.origin + b.dataset.url);
      b.textContent = '¡Copiado!';
      setTimeout(() => (b.textContent = 'Copiar enlace'), 1500);
    }),
  );
</script>
