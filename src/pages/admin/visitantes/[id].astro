---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Recorrido from '../../../components/admin/Recorrido.astro';
import { duracionLegible, lugar, recorridosDe } from '../../../lib/analytics';
import { db } from '../../../lib/db';

export const prerender = false;

const id = Astro.params.id ?? '';
const recorridos = /^[a-f0-9]{16}$/.test(id) ? recorridosDe(id) : [];
if (!recorridos.length) return Astro.redirect('/admin/visitantes');

const mensajes = db.prepare('SELECT id, ts, nombre, servicio FROM mensajes WHERE visitante = ? ORDER BY ts DESC').all(id) as {
  id: number;
  ts: number;
  nombre: string;
  servicio: string;
}[];
const paginas = recorridos.flatMap((r) => r.paginas);
const ultima = recorridos[0].paginas.at(-1)!;
const fecha = (ts: number) => new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium', timeStyle: 'short' }).format(ts);
const datos = [
  { titulo: 'Visitas', valor: String(recorridos.length) },
  { titulo: 'Páginas vistas', valor: String(paginas.length) },
  { titulo: 'Tiempo total', valor: duracionLegible(paginas.reduce((a, p) => a + (p.duracion ?? 0), 0)) },
  { titulo: 'Primera visita', valor: fecha(recorridos.at(-1)!.inicio) },
];
---

<AdminLayout titulo={mensajes[0] ? `Visitante: ${mensajes[0].nombre}` : 'Visitante anónimo'}>
  <a slot="acciones" href="/admin/visitantes" class="text-sm text-gris hover:text-navy-900">← Visitantes</a>

  <p class="text-sm text-gris">
    {lugar(ultima)} · {[ultima.dispositivo, ultima.so, ultima.navegador].filter(Boolean).join(' · ')} · código anónimo
    <code class="rounded bg-slate-100 px-1.5">{id}</code>
  </p>

  <div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    {
      datos.map((t) => (
        <section class="rounded-2xl border border-slate-200 bg-white p-5">
          <h2 class="text-sm font-medium text-gris">{t.titulo}</h2>
          <p class="mt-2 font-display text-2xl font-bold text-navy-900">{t.valor}</p>
        </section>
      ))
    }
  </div>

  {
    mensajes.length > 0 && (
      <section class="mt-4 rounded-2xl border border-naranja/50 bg-white p-5">
        <h2 class="font-display font-semibold text-navy-900">Te escribió desde el formulario</h2>
        <ul class="mt-2 space-y-1 text-sm">
          {mensajes.map((m) => (
            <li>
              <a href="/admin/mensajes" class="text-navy-700 underline">{m.nombre}</a> · {m.servicio} · {fecha(m.ts)}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <h2 class="mt-8 font-display text-lg font-semibold text-navy-900">Historial de visitas</h2>
  <ul class="mt-3 space-y-3">
    {recorridos.map((r) => <Recorrido r={r} enlace={false} />)}
  </ul>
</AdminLayout>
