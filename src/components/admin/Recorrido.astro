---
// Una visita completa: de dónde llegó, desde qué equipo y qué páginas vio, en orden y con su tiempo
import { duracionLegible, lugar, type Recorrido } from '../../lib/analytics';

interface Props {
  r: Recorrido;
  /** Enlace al perfil del visitante (no hace falta dentro del propio perfil) */
  enlace?: boolean;
}
const { r, enlace = true } = Astro.props;
const p0 = r.paginas[0];
const origen = p0.utm ? `${p0.referente ?? 'Enlace'} · ${p0.utm}` : (p0.referente ?? 'Directo / sin referencia');
const total = r.paginas.reduce((a, p) => a + (p.duracion ?? 0), 0);
const fecha = new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium', timeStyle: 'short' }).format(r.inicio);
const hora = (ts: number) => new Intl.DateTimeFormat('es-VE', { timeStyle: 'short' }).format(ts);
const equipo = [p0.dispositivo, p0.so, p0.navegador].filter((x) => x && x !== 'Otro').join(' · ');
---

<li class="rounded-2xl border border-slate-200 bg-white p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="font-semibold text-navy-900">
        {lugar(p0)}
        <span
          class:list={[
            'ml-1 rounded-full px-2 py-0.5 text-xs font-bold',
            r.numero > 1 ? 'bg-acento/15 text-[#047a76]' : 'bg-slate-100 text-gris',
          ]}
        >
          {r.numero > 1 ? `${r.numero}.ª visita` : 'Primera visita'}
        </span>
      </p>
      <p class="mt-0.5 text-sm text-gris">
        {equipo}
        {p0.pantalla && <> · {p0.pantalla.replace('x', '×')}</>}
        {p0.idioma && <> · {p0.idioma}</>}
      </p>
      <p class="mt-0.5 text-sm text-gris">Llegó desde <strong class="font-medium text-tinta">{origen}</strong></p>
    </div>
    <div class="text-right text-sm text-gris">
      <p>{fecha}</p>
      <p>
        {r.paginas.length} {r.paginas.length === 1 ? 'página' : 'páginas'} · {duracionLegible(total)}
      </p>
      {
        enlace && (
          <a href={`/admin/visitantes/${r.visitante}`} class="text-navy-700 underline">
            Ver visitante
          </a>
        )
      }
    </div>
  </div>
  <ol class="mt-4 space-y-1.5 border-l-2 border-naranja/40 pl-4 text-sm">
    {
      r.paginas.map((p) => (
        <li class="flex flex-wrap items-baseline gap-x-3">
          <span class="w-16 shrink-0 text-xs whitespace-nowrap text-gris tabular-nums">{hora(p.ts)}</span>
          <a href={p.ruta} target="_blank" class="min-w-0 truncate font-medium text-navy-900 hover:text-naranja">
            {p.ruta}
          </a>
          <span class="text-xs text-gris">
            {duracionLegible(p.duracion)}
            {p.scroll !== null && p.scroll > 0 && <> · leyó {p.scroll} %</>}
          </span>
        </li>
      ))
    }
  </ol>
</li>
