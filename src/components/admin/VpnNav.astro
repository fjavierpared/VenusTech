---
// Submenú del CRM VPN
import { conexionConfigurada } from '../../lib/wgeasy';
const path = Astro.url.pathname.replace(/\/$/, '');
const tabs = [
  { href: '/admin/vpn/clientes', label: 'Usuarios' },
  { href: '/admin/vpn/descargas', label: 'Descargas' },
  { href: '/admin/vpn/conexion', label: 'Ajustes' },
];
const sinConexion = !conexionConfigurada() && path !== '/admin/vpn/conexion';
const activo = (href: string) => path === href || (path.startsWith(href) && !path.endsWith('/nuevo'));
---

{
  sinConexion && (
    <a href="/admin/vpn/conexion" class="mb-4 block rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">
      ⚠️ La web todavía no está conectada con el servidor VPN: nadie podrá entrar desde la app.
      <strong class="underline">Conectar ahora</strong>
    </a>
  )
}
<div class="mb-6 flex flex-wrap items-center justify-between gap-3">
  <nav class="flex gap-1 overflow-x-auto rounded-full border border-slate-300 bg-white p-0.5 text-sm" aria-label="VPN privada">
    {
      tabs.map((t) => (
        <a
          href={t.href}
          aria-current={activo(t.href) ? 'page' : undefined}
          class:list={['shrink-0 rounded-full px-3.5 py-1.5', activo(t.href) ? 'bg-navy-900 text-white' : 'text-gris hover:text-navy-900']}
        >
          {t.label}
        </a>
      ))
    }
  </nav>
  <a href="/admin/vpn/clientes/nuevo" class="inline-flex items-center gap-1.5 rounded-full bg-naranja px-4 py-2 text-sm font-semibold text-white hover:bg-naranja-600">
    + Nuevo usuario
  </a>
</div>
