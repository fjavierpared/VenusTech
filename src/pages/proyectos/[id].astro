---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { id: p.id }, props: { proyecto: p } }));
}

const { proyecto } = Astro.props as { proyecto: CollectionEntry<'proyectos'> };
const { data } = proyecto;
const { Content } = await render(proyecto);
const path = `/proyectos/${proyecto.id}`;
const migas = [
  { name: 'Proyectos', path: '/proyectos' },
  { name: data.titulo, path },
];

const caso = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.titulo,
  description: data.seoDescription,
  url: new URL(path, SITE.url).href,
  creator: { '@id': `${SITE.url}/#negocio` },
  keywords: data.stack.join(', '),
  inLanguage: 'es-VE',
};
---

<BaseLayout title={data.titulo} description={data.seoDescription} breadcrumbs={migas} schema={[caso]}>
  <PageHero banda={data.categoria} titulo={data.titulo} texto={data.resumen} migas={migas} />

  <section class="bg-white py-16 sm:py-20">
    <div class="container-vt grid gap-12 lg:grid-cols-[1fr_20rem]">
      <article class="prose-vt min-w-0">
        <Content />
      </article>

      <aside class="space-y-5 lg:sticky lg:top-28 lg:self-start">
        {
          data.metricas.length > 0 && (
            <dl class="grid grid-cols-2 gap-3">
              {data.metricas.map((m) => (
                <div class="rounded-2xl bg-navy-900 px-4 py-4 text-white">
                  <dt class="sr-only">{m.etiqueta}</dt>
                  <dd class="font-display text-2xl font-bold text-ambar">{m.valor}</dd>
                  <dd class="text-xs text-white/70">{m.etiqueta}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <div class="rounded-3xl border border-navy-700/10 bg-crema/50 p-6">
          <h2 class="font-display font-bold text-navy-900">Resultados</h2>
          <ul class="mt-3 space-y-2.5 text-sm text-gris">
            {
              data.resultados.map((r) => (
                <li class="flex items-start gap-2">
                  <Icon name="check" size={18} class="mt-0.5 shrink-0 text-acento" strokeWidth={2.25} />
                  {r}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-3xl border border-navy-700/10 p-6">
          <h2 class="font-display font-bold text-navy-900">Tecnologías</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {data.stack.map((t) => <li class="rounded-full bg-crema px-3 py-1 text-xs font-medium text-navy-800">{t}</li>)}
          </ul>
        </div>
        <a href="/proyectos" class="inline-flex items-center gap-2 text-sm font-semibold text-navy-700 hover:text-naranja">
          ← Todos los proyectos
        </a>
      </aside>
    </div>
  </section>

  <CtaFinal titulo="¿Quieres un sistema a la medida de tu negocio?" waMensaje={`Hola, vengo de la web de VenusTech. Vi el proyecto "${data.titulo}" y me interesa algo similar.`} />
</BaseLayout>
