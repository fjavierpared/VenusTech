---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import VpnNav from '../../../../components/admin/VpnNav.astro';
import VpnCredenciales from '../../../../components/admin/VpnCredenciales.astro';
import { crearCliente, cliente, enlaceWa, mensajeBienvenida, ipsVpsLibres, VPS_RANGO_TEXTO } from '../../../../lib/vpn';

export const prerender = false;

const campo = 'mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-navy-700';
let error = '';
let creado: { id: number; clave: string } | null = null;
let v: Record<string, string> = { duracion: 'siempre', dias: '30', dispositivos: '2' };

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  v = Object.fromEntries([...f.entries()].map(([k, x]) => [k, String(x)]));
  try {
    creado = await crearCliente({
      nombre: v.nombre ?? '',
      correo: v.correo ?? '',
      whatsapp: v.whatsapp,
      notas: v.notas,
      maxDispositivos: Number(v.dispositivos) || 2,
      accesoVps: v.acceso_vps === '1',
      dias: v.duracion === 'dias' ? Number(v.dias) : null,
      clave: v.clave,
    });
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}
const c = creado ? cliente(creado.id) : null;
const libresVps = c ? null : await ipsVpsLibres();
---

<AdminLayout titulo="Nuevo usuario de la VPN">
  <VpnNav />

  {
    c && creado ? (
      <>
        <VpnCredenciales
          titulo={`✅ ${c.nombre} ya tiene acceso${c.vence_en ? ` hasta el ${new Intl.DateTimeFormat('es-VE', { dateStyle: 'long' }).format(c.vence_en)}` : ' (sin vencimiento)'}`}
          correo={c.correo}
          clave={creado.clave}
          wa={enlaceWa(c.whatsapp, mensajeBienvenida(c, creado.clave))}
          mensaje={mensajeBienvenida(c, creado.clave)}
        />
        <div class="flex flex-wrap gap-3">
          <a href={`/admin/vpn/clientes/${c.id}`} class="rounded-full bg-navy-900 px-4 py-2 text-sm font-semibold text-white">Ver ficha</a>
          <a href="/admin/vpn/clientes/nuevo" class="rounded-full border border-slate-300 bg-white px-4 py-2 text-sm">Crear otro</a>
        </div>
      </>
    ) : (
      <form method="post" class="grid max-w-3xl gap-6">
        {error && <p class="rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}

        <section class="rounded-2xl border border-slate-200 bg-white p-5">
          <h2 class="font-semibold text-navy-900">Datos</h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <label class="text-sm font-medium text-navy-900">
              Nombre y apellido
              <input id="nombre" name="nombre" required value={v.nombre} class={campo} autocomplete="off" />
            </label>
            <label class="text-sm font-medium text-navy-900">
              Correo (será su usuario)
              <input id="correo" name="correo" type="email" required value={v.correo} class={campo} autocomplete="off" />
            </label>
            <label class="text-sm font-medium text-navy-900 sm:col-span-2">
              Contraseña (opcional)
              <input id="clave" name="clave" type="text" minlength="8" maxlength="72" value={v.clave} placeholder="Déjala vacía y se genera una segura" class={campo} autocomplete="new-password" spellcheck="false" />
              <span class="mt-1 block text-xs font-normal text-gris">Mínimo 8 caracteres. Se verá una sola vez al crear el usuario.</span>
            </label>
            <label class="text-sm font-medium text-navy-900">
              WhatsApp (opcional)
              <input id="whatsapp" name="whatsapp" value={v.whatsapp} placeholder="0414-1234567" class={campo} inputmode="tel" />
            </label>
            <label class="text-sm font-medium text-navy-900">
              Dispositivos permitidos
              <input id="dispositivos" name="dispositivos" type="number" min="1" max="10" value={v.dispositivos} class={campo} />
            </label>
            <label class="text-sm font-medium text-navy-900 sm:col-span-2">
              Notas (opcional)
              <textarea id="notas" name="notas" rows="2" class={campo}>{v.notas}</textarea>
            </label>
          </div>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-5">
          <h2 class="font-semibold text-navy-900">Acceso</h2>
          <fieldset class="mt-4 grid gap-3 sm:grid-cols-2">
            <legend class="sr-only">Duración del acceso</legend>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-300 p-3 has-[:checked]:border-naranja has-[:checked]:bg-crema">
              <input type="radio" name="duracion" value="siempre" checked={v.duracion !== 'dias'} class="accent-naranja" />
              <span>
                <span class="block font-semibold text-navy-900">Sin vencimiento</span>
                <span class="text-sm text-gris">Hasta que lo suspendas o lo borres</span>
              </span>
            </label>
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-300 p-3 has-[:checked]:border-naranja has-[:checked]:bg-crema">
              <input type="radio" name="duracion" value="dias" checked={v.duracion === 'dias'} class="accent-naranja" />
              <span class="flex flex-wrap items-center gap-2">
                <span class="font-semibold text-navy-900">Por</span>
                <input id="dias" name="dias" type="number" min="1" max="3650" value={v.dias} aria-label="Días de acceso" class="w-20 rounded-lg border border-slate-300 px-2 py-1 text-sm" />
                <span class="font-semibold text-navy-900">días</span>
              </span>
            </label>
          </fieldset>

          <label class="mt-4 flex cursor-pointer items-start gap-3 rounded-xl border border-slate-300 p-3 text-sm has-[:checked]:border-amber-400 has-[:checked]:bg-amber-50">
            <input id="acceso_vps" type="checkbox" name="acceso_vps" value="1" checked={v.acceso_vps === '1'} class="mt-0.5 size-4 accent-amber-600" />
            <span>
              <span class="block font-semibold text-navy-900">Acceso a todo el VPS</span>
              <span class="block text-gris">
                Solo para ti o personal de confianza: SSH, Portainer, Uptime Kuma, panel de wg-easy y redes internas. Sus
                dispositivos reciben una IP fija del grupo {VPS_RANGO_TEXTO}. Sin esta opción solo navega por internet.
                {libresVps !== null && <> Quedan <strong>{libresVps}</strong> IPs libres.</>}
              </span>
            </span>
          </label>
        </section>

        <div>
          <button class="rounded-full bg-naranja px-6 py-3 font-semibold text-white hover:bg-naranja-600">Crear usuario y generar acceso</button>
          <p class="mt-2 text-sm text-gris">Se genera una contraseña y verás el botón para enviarle sus datos por WhatsApp.</p>
        </div>
      </form>
    )
  }
</AdminLayout>
