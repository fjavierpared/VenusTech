---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import VpnNav from '../../../components/admin/VpnNav.astro';
import { db } from '../../../lib/db';
import { fechaCorta, dinero, type Pago } from '../../../lib/vpn';

export const prerender = false;

// Mes elegido (AAAA-MM); por defecto el actual
const hoy = new Date();
const param = Astro.url.searchParams.get('mes') ?? '';
const [a, m] = /^\d{4}-\d{2}$/.test(param) ? param.split('-').map(Number) : [hoy.getFullYear(), hoy.getMonth() + 1];
const desde = new Date(a, m - 1, 1).getTime();
const hasta = new Date(a, m, 1).getTime();
const mesTexto = new Intl.DateTimeFormat('es-VE', { month: 'long', year: 'numeric' }).format(desde);
const clave = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const anterior = clave(new Date(a, m - 2, 1));
const siguiente = clave(new Date(a, m, 1));
const esActual = clave(hoy) === clave(new Date(a, m - 1, 1));

const pagos = db
  .prepare(
    `SELECT p.*, c.nombre FROM vpn_pagos p JOIN vpn_clientes c ON c.id = p.cliente_id
     WHERE p.creado_en >= ? AND p.creado_en < ? ORDER BY p.creado_en DESC`,
  )
  .all(desde, hasta) as unknown as (Pago & { nombre: string })[];

const total = pagos.reduce((s, p) => s + p.monto, 0);
const porMetodo = Object.entries(
  pagos.reduce<Record<string, { n: number; monto: number }>>((acc, p) => {
    acc[p.metodo] ??= { n: 0, monto: 0 };
    acc[p.metodo].n++;
    acc[p.metodo].monto += p.monto;
    return acc;
  }, {}),
).sort((x, y) => y[1].monto - x[1].monto);
---

<AdminLayout titulo="Pagos VPN">
  <VpnNav />

  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex items-center gap-2">
      <a href={`?mes=${anterior}`} class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm" aria-label="Mes anterior">←</a>
      <h2 class="min-w-40 text-center font-semibold text-navy-900 capitalize">{mesTexto}</h2>
      {!esActual && <a href={`?mes=${siguiente}`} class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-sm" aria-label="Mes siguiente">→</a>}
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-sm text-gris">Total del mes</p>
      <p class="mt-1 font-display text-3xl font-bold text-navy-900 tabular-nums">{dinero(total)}</p>
      <p class="mt-1 text-xs text-gris">{pagos.length} {pagos.length === 1 ? 'pago' : 'pagos'}</p>
    </div>
    {
      porMetodo.map(([metodo, d]) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-5">
          <p class="text-sm text-gris">{metodo}</p>
          <p class="mt-1 font-display text-2xl font-bold text-navy-900 tabular-nums">{dinero(d.monto)}</p>
          <p class="mt-1 text-xs text-gris">{d.n} {d.n === 1 ? 'pago' : 'pagos'}</p>
        </div>
      ))
    }
  </div>

  {
    pagos.length === 0 ? (
      <p class="mt-6 rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-gris">No hay pagos registrados en {mesTexto}.</p>
    ) : (
      <div class="mt-6 overflow-x-auto rounded-2xl border border-slate-200 bg-white">
        <table class="w-full min-w-[640px] text-sm">
          <thead class="border-b border-slate-200 text-left text-xs tracking-wide text-gris uppercase">
            <tr>
              <th class="px-4 py-3">Fecha</th>
              <th class="px-4 py-3">Cliente</th>
              <th class="px-4 py-3">Plan</th>
              <th class="px-4 py-3">Método</th>
              <th class="px-4 py-3">Referencia</th>
              <th class="px-4 py-3 text-right">Monto</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {pagos.map((p) => (
              <tr class="hover:bg-slate-50">
                <td class="px-4 py-3 tabular-nums">{fechaCorta(p.creado_en)}</td>
                <td class="px-4 py-3"><a href={`/admin/vpn/clientes/${p.cliente_id}`} class="font-medium text-navy-900 hover:underline">{p.nombre}</a></td>
                <td class="px-4 py-3">{p.plan}</td>
                <td class="px-4 py-3">{p.metodo}</td>
                <td class="px-4 py-3 text-gris">{p.referencia ?? '—'}</td>
                <td class="px-4 py-3 text-right font-semibold tabular-nums">{dinero(p.monto)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</AdminLayout>
