---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import VpnNav from '../../../../components/admin/VpnNav.astro';
import VpnCredenciales from '../../../../components/admin/VpnCredenciales.astro';
import Icon from '../../../../components/Icon.astro';
import {
  cliente, dispositivos, pagosDe, planes, METODOS, ESTADOS, estadoDe, fechaCorta, dinero, enlaceWa,
  registrarPago, anularPago, editarCliente, suspender, restablecerClave, borrarDispositivo, borrarCliente, sincronizar,
  mensajeClaveNueva, mensajePagoRecibido, mensajeRecordatorio, type DatosPago,
} from '../../../../lib/vpn';

export const prerender = false;

const id = Number(Astro.params.id);
if (!cliente(id)) return Astro.redirect('/admin/vpn/clientes');

const campo = 'mt-1.5 w-full rounded-xl border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-navy-700';
let error = '';
let aviso = '';
let claveNueva: string | null = null;
let pagoOk = false;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const g = (k: string) => String(f.get(k) ?? '');
  try {
    switch (g('accion')) {
      case 'pago': {
        const plan: DatosPago['plan'] = g('plan') === 'cortesia' ? 'cortesia' : Number(g('plan'));
        await registrarPago(id, {
          plan,
          diasCortesia: Number(g('dias')),
          monto: g('monto') ? Number(g('monto').replace(',', '.')) : undefined,
          metodo: plan === 'cortesia' ? 'Cortesía' : g('metodo'),
          referencia: g('referencia'),
        });
        pagoOk = true;
        break;
      }
      case 'anular_pago':
        await anularPago(Number(g('pago')));
        aviso = 'Pago anulado y vencimiento recalculado.';
        break;
      case 'editar':
        editarCliente(id, { nombre: g('nombre'), correo: g('correo'), whatsapp: g('whatsapp'), notas: g('notas'), maxDispositivos: Number(g('dispositivos')) });
        aviso = 'Datos guardados.';
        break;
      case 'clave':
        claveNueva = restablecerClave(id);
        break;
      case 'suspender':
        await suspender(id, true);
        aviso = 'Cliente suspendido: su VPN se desconectó.';
        break;
      case 'reactivar':
        await suspender(id, false);
        aviso = 'Cliente reactivado.';
        break;
      case 'borrar_disp':
        await borrarDispositivo(Number(g('disp')));
        aviso = 'Dispositivo liberado: puede entrar desde otro teléfono.';
        break;
      case 'sincronizar':
        await sincronizar(id);
        aviso = 'Estado aplicado de nuevo en el servidor VPN.';
        break;
      case 'borrar':
        await borrarCliente(id);
        return Astro.redirect('/admin/vpn/clientes');
    }
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

const c = cliente(id)!;
const estado = estadoDe(c);
const disp = dispositivos(id);
const pagos = pagosDe(id);
const lista = planes();
const total = pagos.reduce((s, p) => s + p.monto, 0);
const waPago = pagoOk ? enlaceWa(c.whatsapp, mensajePagoRecibido(c)) : null;
const waRecordar = enlaceWa(c.whatsapp, mensajeRecordatorio(c));
const fechaHora = (ts: number | null) =>
  ts ? new Intl.DateTimeFormat('es-VE', { dateStyle: 'medium', timeStyle: 'short' }).format(ts) : 'Nunca';
---

<AdminLayout titulo={c.nombre}>
  <VpnNav />

  {error && <p class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-800">{error}</p>}
  {aviso && <p class="mb-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900">{aviso}</p>}
  {
    pagoOk && (
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-900">
        <span>✅ Pago registrado. Activo hasta el <strong>{fechaCorta(c.vence_en)}</strong>.</span>
        {waPago && (
          <a href={waPago} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-[#25D366] px-3 py-1.5 font-semibold text-[#073b1d]">
            <Icon name="whatsapp" size={14} /> Avisarle por WhatsApp
          </a>
        )}
      </div>
    )
  }
  {
    claveNueva && (
      <VpnCredenciales
        titulo="Contraseña nueva generada (la anterior ya no sirve)"
        correo={c.correo}
        clave={claveNueva}
        wa={enlaceWa(c.whatsapp, mensajeClaveNueva(c, claveNueva))}
        mensaje={mensajeClaveNueva(c, claveNueva)}
      />
    )
  }

  <!-- Cabecera del cliente -->
  <section class="rounded-2xl border border-slate-200 bg-white p-5">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class:list={['rounded-full px-2.5 py-0.5 text-xs font-semibold', ESTADOS[estado].clase]}>{ESTADOS[estado].texto}</span>
          <span class="text-sm text-gris">Cliente desde {fechaCorta(c.creado_en)}</span>
        </div>
        <p class="mt-2 text-sm break-all text-gris">{c.correo}{c.whatsapp && <> · {c.whatsapp}</>}</p>
        {c.notas && <p class="mt-2 text-sm whitespace-pre-line text-tinta">{c.notas}</p>}
      </div>
      <div class="text-right">
        <p class="text-sm text-gris">Plan {c.plan ?? '—'}</p>
        <p class="font-display text-2xl font-bold text-navy-900">{c.vence_en ? `Vence ${fechaCorta(c.vence_en)}` : 'Sin plan'}</p>
        <p class="text-xs text-gris">Total pagado: {dinero(total)}</p>
      </div>
    </div>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
      {
        waRecordar && (
          <a href={waRecordar} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full bg-[#25D366] px-3 py-1.5 text-sm font-semibold text-[#073b1d]">
            <Icon name="whatsapp" size={14} /> Recordar pago
          </a>
        )
      }
      <form method="post">
        <button name="accion" value="clave" class="rounded-full border border-slate-300 px-3 py-1.5 text-sm" onclick="return confirm('¿Generar una contraseña nueva? La actual dejará de servir y se cerrará su sesión en la app.')">
          Generar contraseña nueva
        </button>
      </form>
      <form method="post">
        {
          c.suspendido ? (
            <button name="accion" value="reactivar" class="rounded-full border border-emerald-300 px-3 py-1.5 text-sm text-emerald-800">Reactivar</button>
          ) : (
            <button name="accion" value="suspender" class="rounded-full border border-amber-300 px-3 py-1.5 text-sm text-amber-800" onclick="return confirm('¿Suspender? Su VPN se desconecta hasta que lo reactives.')">
              Suspender
            </button>
          )
        }
      </form>
    </div>
  </section>

  <div class="mt-6 grid gap-6 xl:grid-cols-2">
    <!-- Registrar pago -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-navy-900">Registrar pago o renovar</h2>
      <p class="text-sm text-gris">Se suma al tiempo que le quede. Si ya venció, cuenta desde hoy.</p>
      <form method="post" class="mt-4 grid gap-4">
        <input type="hidden" name="accion" value="pago" />
        <div class="grid gap-2 sm:grid-cols-3">
          {
            lista.map((p, i) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-300 p-2.5 text-sm has-[:checked]:border-naranja has-[:checked]:bg-crema">
                <input type="radio" name="plan" value={p.id} checked={i === 0} class="accent-naranja" />
                <span><strong class="text-navy-900">{p.nombre}</strong> {dinero(p.precio)}</span>
              </label>
            ))
          }
          <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-300 p-2.5 text-sm has-[:checked]:border-naranja has-[:checked]:bg-crema">
            <input type="radio" name="plan" value="cortesia" class="accent-naranja" />
            <span><strong class="text-navy-900">Gratis</strong> días</span>
          </label>
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
          <label class="text-sm font-medium text-navy-900" data-solo="pago">
            Método
            <select id="pago-metodo" name="metodo" class={campo}>{METODOS.filter((m) => m !== 'Cortesía').map((m) => <option>{m}</option>)}</select>
          </label>
          <label class="text-sm font-medium text-navy-900" data-solo="pago">
            Monto ($)
            <input id="pago-monto" name="monto" inputmode="decimal" placeholder="Precio del plan" class={campo} />
          </label>
          <label class="text-sm font-medium text-navy-900" data-solo="pago">
            Referencia
            <input id="pago-ref" name="referencia" class={campo} />
          </label>
          <label class="text-sm font-medium text-navy-900" data-solo="cortesia" hidden>
            Días gratis
            <input id="pago-dias" name="dias" type="number" min="1" max="3650" value="7" class={campo} />
          </label>
        </div>
        <button class="justify-self-start rounded-full bg-naranja px-5 py-2.5 text-sm font-semibold text-white hover:bg-naranja-600">Registrar</button>
      </form>
    </section>

    <!-- Dispositivos -->
    <section class="rounded-2xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-navy-900">Dispositivos ({disp.length} de {c.max_dispositivos})</h2>
      <p class="text-sm text-gris">Se agregan solos cuando entra a la app desde un teléfono nuevo.</p>
      {
        disp.length === 0 ? (
          <p class="mt-4 rounded-xl bg-slate-50 p-5 text-center text-sm text-gris">Aún no ha entrado a la app desde ningún dispositivo.</p>
        ) : (
          <ul class="mt-4 divide-y divide-slate-100">
            {disp.map((d) => (
              <li class="flex items-center justify-between gap-3 py-2.5 text-sm">
                <span class="min-w-0">
                  <span class="block truncate font-medium text-navy-900">{d.nombre}</span>
                  <span class="block text-xs text-gris">Desde {fechaCorta(d.creado_en)} · último uso {fechaHora(d.ultimo_acceso)}</span>
                </span>
                <form method="post">
                  <input type="hidden" name="disp" value={d.id} />
                  <button name="accion" value="borrar_disp" class="rounded-full border border-red-200 px-3 py-1 text-xs text-red-700" onclick="return confirm('¿Liberar este dispositivo? Se desconecta y podrá entrar desde otro.')">
                    Liberar
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </div>

  <!-- Historial de pagos -->
  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
    <h2 class="font-semibold text-navy-900">Historial de pagos</h2>
    {
      pagos.length === 0 ? (
        <p class="mt-4 text-sm text-gris">Sin pagos registrados.</p>
      ) : (
        <div class="mt-4 overflow-x-auto">
          <table class="w-full min-w-[560px] text-sm">
            <thead class="text-left text-xs tracking-wide text-gris uppercase">
              <tr><th class="py-2">Fecha</th><th>Plan</th><th>Método</th><th>Referencia</th><th>Cubre</th><th class="text-right">Monto</th><th></th></tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {pagos.map((p) => (
                <tr>
                  <td class="py-2.5">{fechaCorta(p.creado_en)}</td>
                  <td>{p.plan}</td>
                  <td>{p.metodo}</td>
                  <td class="text-gris">{p.referencia ?? '—'}</td>
                  <td class="text-gris">{fechaCorta(p.desde)} → {fechaCorta(p.hasta)}</td>
                  <td class="text-right font-semibold tabular-nums">{dinero(p.monto)}</td>
                  <td class="text-right">
                    <form method="post">
                      <input type="hidden" name="pago" value={p.id} />
                      <button name="accion" value="anular_pago" class="text-xs text-red-700 underline" onclick="return confirm('¿Anular este pago? Se le restan esos días.')">Anular</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <!-- Editar datos -->
  <details class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
    <summary class="cursor-pointer font-semibold text-navy-900">Editar datos del cliente</summary>
    <form method="post" class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="text-sm font-medium text-navy-900">Nombre<input id="e-nombre" name="nombre" value={c.nombre} required class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">Correo (usuario)<input id="e-correo" name="correo" type="email" value={c.correo} required class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">WhatsApp<input id="e-wa" name="whatsapp" value={c.whatsapp ?? ''} class={campo} /></label>
      <label class="text-sm font-medium text-navy-900">Dispositivos permitidos<input id="e-disp" name="dispositivos" type="number" min="1" max="10" value={c.max_dispositivos} class={campo} /></label>
      <label class="text-sm font-medium text-navy-900 sm:col-span-2">Notas<textarea id="e-notas" name="notas" rows="2" class={campo}>{c.notas ?? ''}</textarea></label>
      <div class="flex flex-wrap items-center justify-between gap-3 sm:col-span-2">
        <button name="accion" value="editar" class="rounded-full bg-navy-900 px-5 py-2.5 text-sm font-semibold text-white">Guardar</button>
        <span class="flex gap-2">
          <button name="accion" value="sincronizar" formnovalidate class="rounded-full border border-slate-300 px-3 py-1.5 text-xs">Reaplicar en servidor</button>
          <button name="accion" value="borrar" formnovalidate class="rounded-full border border-red-200 px-3 py-1.5 text-xs text-red-700" onclick="return confirm('¿Borrar este cliente con todos sus pagos y dispositivos? No se puede deshacer.')">
            Borrar cliente
          </button>
        </span>
      </div>
    </form>
  </details>
</AdminLayout>

<script>
  const aplicar = () => {
    const cortesia = document.querySelector<HTMLInputElement>('input[name="plan"]:checked')?.value === 'cortesia';
    document.querySelectorAll<HTMLElement>('[data-solo]').forEach((el) => {
      el.hidden = (el.dataset.solo === 'cortesia') !== cortesia;
    });
  };
  document.querySelectorAll('input[name="plan"]').forEach((r) => r.addEventListener('change', aplicar));
  aplicar();
</script>
